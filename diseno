<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Peliculas animadas</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
            padding: 0;
            background-color: aliceblue;
        }

        header{
            background-color: black;
            color: aliceblue;
            text-align: center;
            padding: 20px 0;
        }

        .menu-btn {
            display: none;
            cursor: pointer;
            padding: 15px 20px;
            background-color: black;
            color: aliceblue;
            border: 1px solid aliceblue;
            width: 30px;
            margin: auto;
        }

        .product-card {
            background-color: aliceblue;
            border: 1px solid aliceblue;
            border-radius: 5px;
            padding: 15px;
            margin: 20px;
            width: 300px;
            display: inline-block;
        }

        .product-card img {
            width: 100%;
            height: auto;
            margin-bottom: 10px;
        }

        @media (max-width: 600px) {
            .product-card {
                width: 90%;
                margin: 10px auto;
            }

            .menu-btn {
                display: block;
            }
            
            header {
                padding: 10px 0;
            }
        }
    </style>
</head>
<body>
    <header>
        <h1>Peliculas animadas</h1>
        <div class="menu-btn">Menú</div>
    </header>
    <div class="product-card">
        <img src="https://th.bing.com/th/id/R.66b87ed6a638c8e95294fbfcefb7dade?rik=rQh7x373c3xTZg&pid=ImgRaw&r=0" alt="Producto 1">
        <h3>Pelicula 1</h3>
        <p>Descripción del producto 1.</p>
        <p>$19.99</p>
        <a href="#">Comprar</a>
    </div>

    <div class="product-card">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQq5TRVvc1thkmn9LZd2HsI7BURDPJa4RonYAUSeRgF5g&s=10" alt="Producto 2">
        <h3>Pelicula 1</h3>
        <p>Descripción del producto 1.</p>
        <p>$24.99</p>
        <a href="#">Comprar</a>
    </div>

    <div class="product-card">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR2hGU-j7PV3S0Ndk6vGdzTyySY3-w6hx93D2flZ6gTiQ&s=10" alt="Producto 3">
        <h3>Pelicula 1</h3>
        <p>Descripción del producto 1.</p>
        <p>$29.99</p>
        <a href="#">Comprar</a>
    </div>
</body>
</html>
